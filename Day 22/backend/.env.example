# Multi-Agent Research Assistant Environment Configuration

# Provider can be "mock" (default, runs 100% locally with zero external dependencies),
# "openai", or "gemini".
LLM_PROVIDER=mock

# LLM API Keys (Only required if LLM_PROVIDER is set to openai or gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model override
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
